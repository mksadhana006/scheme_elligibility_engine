# --- Adhikaar AI Engine Configuration ---

# Google Gemini API Key (for LLM re-ranking)
# Get a free key at: https://aistudio.google.com/apikey
# Optional: The app works without this, using only semantic search + rules.
GEMINI_API_KEY=

# Google Custom Search API Key (for fetching newly announced schemes)
# Get a key at: https://developers.google.com/custom-search/v1/introduction
# Optional: The app works without this, skipping the web search feature.
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here

# Google Custom Search Engine ID
# Create one at: https://programmablesearchengine.google.com/
# Set it to search sites like india.gov.in, pib.gov.in, myscheme.gov.in
GOOGLE_SEARCH_CX=your_custom_search_engine_id_here

# Google Maps API Key (for Nearby Search for application centers)
# Get a key at: https://developers.google.com/maps/documentation/places/web-service/overview
# Required for the "Find Nearest Application Center" feature.


